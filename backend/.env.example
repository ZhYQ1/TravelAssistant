# ===== Redis（方案、路由审计共享同一实例，使用不同 Key 前缀）=====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== LLM（讯飞星辰 OpenAI Chat 兼容接口，用于 L3-b 精判与回退）=====
LLM_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
LLM_API_KEY=
LLM_MODEL=spark-x2.6-4b
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=8

# ===== Embedding（SiliconFlow OpenAI 兼容接口，用于 L2 向量召回）=====
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT_SECONDS=5

# ===== 路由阈值（Spec 中标为 TBD，须由评审确定后填入）=====
# L2：最高相似度下限与 top1/top2 区分度
VECTOR_MIN_SCORE=0.62
VECTOR_MARGIN=0.05
# Jev（TypeSafe 官方 Python SDK 直连，替代本地 Java adapter sidecar）
# api key 直接配置在本服务进程，不再经过 Java 服务转发。
TYPESAFE_API_KEY=
# 可选：显式指定 Jev 模型与自托管端点，留空则使用官方默认。
JEV_MODEL=
TYPESAFE_BASE_URL=
JEV_TIMEOUT_SECONDS=18
# Jev：低于该置信度回退 LLM 精判
JEV_CONFIDENCE_THRESHOLD=0.75

# ===== Key 前缀与生命周期 =====
KEY_PREFIX=ta:route
AUDIT_TTL_SECONDS=604800
PLAN_TTL_SECONDS=604800
REVIEW_TTL_SECONDS=604800
CONTINUATION_TTL_SECONDS=3600
SKILL_STATE_TTL_SECONDS=86400
SKILL_CONTENT_TTL_SECONDS=604800

# ===== 审核闭环与上下文优化 =====
MAX_REVIEW_ROUNDS=3
COLLAPSE_AFTER_TURNS=3

# ===== 第三方 Skill 执行隔离 =====
SKILL_BASE_DIR=.runtime/skill_executions
SKILL_TIMEOUT_SECONDS=30